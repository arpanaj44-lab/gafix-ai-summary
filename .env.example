# ── Provider switch ──
# Defaults to "bedrock" if unset. Only set this to "anthropic" if you later
# decide to use a direct Anthropic API key as a fallback — not needed otherwise.
LLM_PROVIDER=bedrock

# ── AWS Bedrock (required — this is the only provider in use) ──
# Get these from your cloud team once Bedrock access is granted.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
# Confirm the exact model ID in the Bedrock console (Model catalog → Claude Sonnet 5 →
# API request tab) — it sometimes includes a date suffix. Override here if different.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-v1:0

# ── Anthropic direct (NOT currently used — leave unset) ──
# Only needed if LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5
